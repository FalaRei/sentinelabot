# Copia para .env.local (local) ou cria estas variáveis no projeto da Vercel. Nunca as ponhas no Git.
# Basta UMA chave de IA. Ordem de preferência: FAL_KEY > DEEPSEEK_API_KEY > OPENAI_API_KEY.
FAL_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Código que vai no link de teste (?codigo=...). Sem ele, a API recusa todos os pedidos.
CODIGO_TESTE=
